<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Shared.uss" />
    <ui:VisualElement name="VsAiSetupRoot" class="screen-root">
        <ui:Button name="BackButton" text="&lt;" class="back-button" />
        <ui:Label name="TitleLabel" text="VS AI" class="title-text" style="font-size: 28px;" />

        <ui:VisualElement class="card">
            <ui:Label text="Number of Players" style="color: rgb(160,163,178); font-size: 13px; margin-bottom: 6px;" />
            <ui:RadioButtonGroup name="PlayerCountGroup" choices="2 Players,3 Players,4 Players" value="2" />

            <ui:VisualElement class="spacer-small" />
            <ui:Label name="DifficultyLabel" text="AI Difficulty" style="color: rgb(160,163,178); font-size: 13px; margin-bottom: 6px;" />
            <ui:RadioButtonGroup name="DifficultyGroup" choices="Easy,Normal,Hard,Expert" value="1" />
        </ui:VisualElement>

        <ui:Button name="StartMatchButton" text="START MATCH" class="primary-button" style="width: 260px;" />
    </ui:VisualElement>
</ui:UXML>
