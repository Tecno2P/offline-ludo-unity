<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Shared.uss" />
    <ui:VisualElement name="StatisticsRoot" class="screen-root">
        <ui:Button name="BackButton" text="&lt;" class="back-button" />
        <ui:Label text="STATISTICS" class="title-text" style="font-size: 28px;" />

        <ui:VisualElement class="card">
            <ui:VisualElement class="stat-row"><ui:Label text="Total Matches" class="stat-label" /><ui:Label name="TotalMatchesValue" text="0" class="stat-value" /></ui:VisualElement>
            <ui:VisualElement class="stat-row"><ui:Label text="Wins" class="stat-label" /><ui:Label name="WinsValue" text="0" class="stat-value" /></ui:VisualElement>
            <ui:VisualElement class="stat-row"><ui:Label text="Losses" class="stat-label" /><ui:Label name="LossesValue" text="0" class="stat-value" /></ui:VisualElement>
            <ui:VisualElement class="stat-row"><ui:Label text="Win Rate" class="stat-label" /><ui:Label name="WinRateValue" text="0%" class="stat-value" /></ui:VisualElement>
            <ui:VisualElement class="stat-row"><ui:Label text="AI Wins" class="stat-label" /><ui:Label name="AiWinsValue" text="0" class="stat-value" /></ui:VisualElement>
            <ui:VisualElement class="stat-row"><ui:Label text="Local MP Wins" class="stat-label" /><ui:Label name="LocalWinsValue" text="0" class="stat-value" /></ui:VisualElement>
            <ui:VisualElement class="stat-row"><ui:Label text="LAN Wins" class="stat-label" /><ui:Label name="LanWinsValue" text="0" class="stat-value" /></ui:VisualElement>
        </ui:VisualElement>

        <ui:Label text="Match History" style="color: rgb(255,176,59); font-size: 16px; -unity-font-style: bold; margin-top: 12px; margin-bottom: 6px;" />
        <ui:ScrollView name="MatchHistoryScroll" style="width: 340px; max-height: 220px;">
            <ui:VisualElement name="MatchHistoryList" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
